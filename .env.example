# Configurar estos valores en Environment de Dokploy; no guardar contraseñas reales en Git.
DATABASE_URL=mysql://data_user:CLAVE_USUARIO_CODIFICADA@HOST_INTERNO:3306/data
MIGRATION_DATABASE_URL=mysql://root:CLAVE_ROOT_CODIFICADA@HOST_INTERNO:3306/data
NEXO_BASE_PATH=/
PORT=3000
AUTO_MIGRATE=1
# Clave base64 de 32 bytes para cifrar credenciales SMTP y enlaces de documentos. Conservarla entre despliegues.
# Generar con: php -r "echo base64_encode(random_bytes(32));"
NEXO_MAIL_ENCRYPTION_KEY=
# URL pública completa del sistema, incluyendo subcarpeta si corresponde. No usar localhost en el VPS.
NEXO_PUBLIC_URL=
